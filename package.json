{
  "name": "scrawl-boards",
  "version": "0.1.5",
  "description": "Scrawl Boards: local drawing boards with MCP support for AI agents.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/yashagw/excalidraw-boards.git"
  },
  "scripts": {
    "dev": "vite build -c vite.server.config.ts && concurrently -k -n build,server,ui \"vite build -c vite.server.config.ts --watch\" \"node --watch dist/server/index.js\" \"vite\"",
    "build": "vite build && vite build -c vite.server.config.ts",
    "start": "node dist/server/index.js",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.server.json",
    "test": "vitest run",
    "desktop:prepare": "npm run build && node scripts/prepare-desktop.mjs",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:smoke": "node scripts/smoke-desktop.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "compression": "^1.8.2",
    "express": "^5.3.0",
    "proper-lockfile": "^4.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "@tauri-apps/cli": "^2.12.4",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "fractional-indexing": "^3.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
