{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Scrawl",
  "version": "0.1.5",
  "identifier": "com.scrawl.desktop",
  "build": {
    "beforeBuildCommand": "npm run desktop:prepare",
    "beforeDevCommand": { "script": "npm run desktop:prepare", "wait": true },
    "frontendDist": "../desktop-ui"
  },
  "app": { "withGlobalTauri": true, "windows": [], "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'" } },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": { "desktop-runtime/": "desktop-runtime/" }
  }
}
